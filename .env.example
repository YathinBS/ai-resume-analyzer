# GEMINI_API_KEY: Required for Google Gemini AI calls (Gemini 3.8 Flash)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (AWS RDS or local docker)
DATABASE_URL="postgresql+asyncpg://postgres:postgres123@localhost:5432/resumeai"

# JWT_SECRET: Strong random string for signing JWT authentication tokens
JWT_SECRET="resume-ai-production-jwt-secret-key-2026-secure"

# CORS_ORIGINS: Comma-separated allowed origins for FastAPI backend
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT=3000

